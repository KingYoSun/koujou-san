# pnpm setup replaces __GENERATE_SECRET__ in a new .env. Existing .env is preserved.
# Local development only. All published service ports bind to 127.0.0.1.
KOUJOU_API_ADDR=127.0.0.1:8080
POSTGRES_ADMIN_PASSWORD=__GENERATE_SECRET__
KOUJOU_DB_PASSWORD=__GENERATE_SECRET__
KRATOS_DB_PASSWORD=__GENERATE_SECRET__
HYDRA_DB_PASSWORD=__GENERATE_SECRET__
ARCADEDB_ROOT_PASSWORD=__GENERATE_SECRET__
KRATOS_COOKIE_SECRET=__GENERATE_SECRET__
KRATOS_CIPHER_SECRET=__GENERATE_SECRET__
HYDRA_SYSTEM_SECRET=__GENERATE_SECRET__
KOUJOU_AUTH_ENABLED=1
KOUJOU_AUTH_KEY=__GENERATE_SECRET__
KOUJOU_WEB_CLIENT_SECRET=__GENERATE_SECRET__
KOUJOU_CONTEXT_MAX_BYTES=16777216
KOUJOU_CONTEXT_MAX_PLACEMENTS=100000
KOUJOU_CONTEXT_MAX_LOADED=100000
KOUJOU_SEARCH_DIR=.cache/search
KOUJOU_SEARCH_REBUILD=0
# Optional GitHub App observer. Configuration and key files stay outside Git.
KOUJOU_GITHUB_CONFIG=

# Optional server LLM gateway: pnpm run infra:llm:up prepares local credentials.
KOUJOU_SERVER_LLM_CONFIG=.cache/bifrost/connections.json
BIFROST_ADMIN_PASSWORD=__GENERATE_SECRET__
BIFROST_ENCRYPTION_KEY=__GENERATE_SECRET__
BIFROST_WORKER_KEY=

# Graph credentials default to the generated local ArcadeDB root password in dev:api.
KOUJOU_GRAPH_URL=http://127.0.0.1:2480
KOUJOU_GRAPH_USER=root
KOUJOU_GRAPH_DATABASE=koujou_graph
KOUJOU_GRAPH_DEPTH=8
KOUJOU_GRAPH_NODES=2000
KOUJOU_GRAPH_EDGES=10000
KOUJOU_GRAPH_PAGE=100
KOUJOU_GRAPH_TIMEOUT_MS=2000
